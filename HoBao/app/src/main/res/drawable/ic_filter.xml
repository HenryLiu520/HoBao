<?xml version="1.0" encoding="utf-8"?>
<!--
  漏斗（筛选）图标。
  官方 material-icons-core 只提供约 40 个基础图标（Add/List/Settings/Search/Delete…），
  里面没有漏斗，material-icons-extended 那个大集合又已停止随版本更新。
  所以这里用矢量图自己画一个 —— 24x24 视口，路径就是一个漏斗轮廓。
  好处：几十字节、随主题染色、任何分辨率都清晰。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M4,5h16l-6.5,8.5v5.5l-3,-2v-3.5z" />
</vector>
